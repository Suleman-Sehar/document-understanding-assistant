# Environment for the LLM extractor (document-understanding-assistant).
# Copy to .env and fill in the key. Never commit a real .env.

# OpenRouter API key (https://openrouter.ai/keys).
OPENAI_API_KEY=

# OpenRouter OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model slug MUST keep the provider prefix.
# "google/gemma-4-31b-it:free" is pinned to Google AI Studio and costs nothing;
# an unprefixed slug is auto-routed by OpenRouter and can be served by another
# provider, which silently changes the model under test.
# Note: google/gemini-flash-1.5 was retired by OpenRouter and has 0 providers.
OPENAI_MODEL=google/gemma-4-31b-it:free

# Free models are limited to 50 requests per day per key, so a 100-document run
# spans more than one day. Completed documents are cached per model, so a rerun
# only pays for the documents that are still missing.

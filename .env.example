# Environment for the LLM extractor (document-understanding-assistant).
# Copy to .env and fill in the key. Never commit a real .env.

# OpenRouter API key (https://openrouter.ai/keys).
OPENAI_API_KEY=

# OpenRouter OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model slug MUST keep the provider prefix.
# "openai/gpt-4o-mini" is pinned to OpenAI; an unprefixed slug such as
# "gpt-4o-mini" is auto-routed by OpenRouter and can be served by another
# provider instead, which silently changes the model under test.
OPENAI_MODEL=openai/gpt-4o-mini
